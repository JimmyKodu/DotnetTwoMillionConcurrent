# Example configurations for different test scenarios

# Small test - 100 devices
MQTT_SERVER=localhost
MQTT_PORT=5000
TOTAL_DEVICES=100
BATCH_SIZE=100
REPORT_INTERVAL=10
CONNECTIONS_PER_SECOND=50

# Medium test - 10,000 devices
# TOTAL_DEVICES=10000
# BATCH_SIZE=1000
# REPORT_INTERVAL=30
# CONNECTIONS_PER_SECOND=500

# Large test - 100,000 devices
# TOTAL_DEVICES=100000
# BATCH_SIZE=5000
# REPORT_INTERVAL=60
# CONNECTIONS_PER_SECOND=1000

# Full test - 2,000,000 devices (requires significant resources)
# TOTAL_DEVICES=2000000
# BATCH_SIZE=10000
# REPORT_INTERVAL=180
# CONNECTIONS_PER_SECOND=1000

# Usage:
# 1. Copy this file: cp .env.example .env
# 2. Uncomment and modify the configuration you want to use
# 3. Run: set -a && source .env && dotnet run
