@model MqttServer.Models.StatisticsViewModel
@{
    ViewData["Title"] = "MQTT Server Dashboard";
}

<div class="container mt-4">
    <h1 class="display-4 text-center mb-4">MQTT Server Statistics</h1>
    
    <div class="row">
        <div class="col-md-6 mb-3">
            <div class="card">
                <div class="card-body">
                    <h5 class="card-title">Connected Devices</h5>
                    <p class="card-text display-6">@Model.ConnectedDevices.ToString("N0")</p>
                </div>
            </div>
        </div>
        
        <div class="col-md-6 mb-3">
            <div class="card">
                <div class="card-body">
                    <h5 class="card-title">Messages Received</h5>
                    <p class="card-text display-6">@Model.MessagesReceived.ToString("N0")</p>
                </div>
            </div>
        </div>
        
        <div class="col-md-6 mb-3">
            <div class="card">
                <div class="card-body">
                    <h5 class="card-title">Messages Processed</h5>
                    <p class="card-text display-6">@Model.MessagesProcessed.ToString("N0")</p>
                </div>
            </div>
        </div>
        
        <div class="col-md-6 mb-3">
            <div class="card">
                <div class="card-body">
                    <h5 class="card-title">Messages/Second</h5>
                    <p class="card-text display-6">@Model.MessagesPerSecond.ToString("N2")</p>
                </div>
            </div>
        </div>
        
        <div class="col-md-12 mb-3">
            <div class="card">
                <div class="card-body">
                    <h5 class="card-title">Server Uptime</h5>
                    <p class="card-text display-6">@string.Format("{0:D2}d {1:D2}h {2:D2}m {3:D2}s", Model.Uptime.Days, Model.Uptime.Hours, Model.Uptime.Minutes, Model.Uptime.Seconds)</p>
                </div>
            </div>
        </div>
    </div>
    
    <div class="text-center mt-4">
        <a href="javascript:location.reload()" class="btn btn-primary">Refresh Statistics</a>
    </div>
    
    <div class="mt-4">
        <h3>Connection Information</h3>
        <p><strong>MQTT Endpoint:</strong> ws://localhost:5000/mqtt</p>
        <p><strong>Port:</strong> 5000</p>
        <p class="text-muted">Configure devices to connect to this endpoint to start sending data.</p>
    </div>
</div>

<script>
    // Auto-refresh every 5 seconds
    setTimeout(function() {
        location.reload();
    }, 5000);
</script>
